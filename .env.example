# ============================================================
#      ARCHIVO DE VARIABLES DE ENTORNO PARA DESARROLLO
# ============================================================
#
# Este archivo es una plantilla. Copia su contenido a un nuevo
# archivo llamado .env y ajústalo según tus necesidades.
#
# ¡IMPORTANTE! No uses 'root' como DB_USER.
# La imagen de MySQL creará automáticamente la base de datos
# y el usuario especificados aquí. El usuario 'root' se
# configura exclusivamente con DB_ROOT_PASSWORD.
#
# ============================================================

# ------------------------------------------
# Configuración de la Base de Datos
# ------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tutorium_db
DB_USER=tutorium_user
DB_PASSWORD=tutorium_password
DB_ROOT_PASSWORD=1234

# ------------------------------------------
# Configuración de la Aplicación para Desarrollo
# ------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000